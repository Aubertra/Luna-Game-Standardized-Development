# ================================================
# Unity 专用 .gitignore
# ================================================

# ---------- 1. 强制忽略的本地生成目录 ----------
# Visual Studio
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.userprefs

# Unity 本地生成目录
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
/[Bb]uilds/

# Luna 框架临时文件
LunaTemp/

# 本地项目版本（可能含路径）
ProjectSettings/ProjectVersion.txt

# 临时文件和备份
Temp.txt
Backup/

# IDE 生成
*.csproj
*.unityproj
*.sln

# ---------- 2. Unity 自动生成，不纳入版本控制 ----------
# 崩溃内存转储
*.mdb
*.apk
*.aab
*.unitypackage
*.app

# 资源数据库
AssetStoreTools*

# 自动生成的导航数据
NavMeshData/

# 自动生成的照明数据
*.lighting

# ---------- 3. IDE 和工具生成的本地文件 ----------
# Visual Studio / Rider
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userosscache
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# ---------- 4. 操作系统文件 ----------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ---------- 5. 其他注意事项 ----------
# 类型文件和缓存
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk